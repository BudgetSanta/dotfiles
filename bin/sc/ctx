#!/usr/bin/env bash

NAMESPACES=("bsa" "bsa2" "data-gen" "datastores1" "datastores2" "fe" "test-namespace" "unified-lib" "uxa" "uxa2")

help() {
  echo "Interactively select a Kubernetes namespace and set it as the current context."
  echo
  echo "Usage: $0 [NAMESPACE]"
  echo
  echo "If NAMESPACE is provided, it will be pre-filled in the selection filter."
  echo
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo "  -l, --list    List available namespaces"
}

exe-req 'gum'

# Parse options
while [[ $# -gt 0 ]]; do
  case $1 in
  -h | --help)
    help
    exit 0
    ;;
  -l | --list)
    printf '%s\n' "${NAMESPACES[@]}"
    exit 0
    ;;
  --* | -*)
    echo "Unknown option: '$1'" 1>&2
    exit 1
    ;;
  *)
    break
    ;;
  esac
done

GUM_ARGS=(
  --placeholder="Pick a namespace..."
  --fuzzy)

if [[ $# -gt 0 ]]; then
  GUM_ARGS+=(--value="$1")
fi

NAMESPACE=$(gum filter "${GUM_ARGS[@]}" "${NAMESPACES[@]}")

LEGACY_DEV_CONTEXT="eks01-ap-southeast-2-development"

# Get current context
CURRENT_CONTEXT=$(kubectl config current-context)

# Switch to legacy dev context if not already on it
if [[ "$CURRENT_CONTEXT" != "$LEGACY_DEV_CONTEXT" ]]; then
  kubectl config use-context "$LEGACY_DEV_CONTEXT" >/dev/null
fi

kubectl config set-context --current --namespace="$NAMESPACE" >/dev/null
