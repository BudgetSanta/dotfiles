#!/usr/bin/env bash

help() {
  echo "Set a dynamic namespace in the slate Kubernetes context."
  echo
  echo "Usage: $(basename $0) [OPTIONS] [NAMESPACE]"
  echo
  echo "This command will:"
  echo "  1. Switch to the slate context if not already on it"
  echo "  2. Set the specified namespace"
  echo
  echo "Options:"
  echo "  -d, --default Set namespace to 'default'"
  echo "  -h, --help    Show this help message"
}

# Parse options
USE_DEFAULT=false

while [[ $# -gt 0 ]]; do
  case $1 in
  -d | --default)
    USE_DEFAULT=true
    shift
    ;;
  -h | --help)
    help
    exit 0
    ;;
  --* | -*)
    echo "Unknown option: '$1'" 1>&2
    exit 1
    ;;
  *)
    break
    ;;
  esac
done

# Determine namespace
if [[ "$USE_DEFAULT" == true ]]; then
  NAMESPACE="default"
else
  # Check if namespace argument is provided
  if [[ $# -eq 0 ]]; then
    echo "Error: NAMESPACE argument is required" 1>&2
    echo
    help
    exit 1
  fi
  NAMESPACE="$1"
fi
SLATE_CONTEXT="eks01-ap-southeast-2-development-sc001"

# Get current context
CURRENT_CONTEXT=$(kubectl config current-context)

# Switch to slate context if not already on it
if [[ "$CURRENT_CONTEXT" != "$SLATE_CONTEXT" ]]; then
  kubectl config use-context "$SLATE_CONTEXT" >/dev/null
fi

# Set the namespace
kubectl config set-context --current --namespace="$NAMESPACE" >/dev/null
